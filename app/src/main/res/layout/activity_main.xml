<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:paddingRight="50dp"
        android:scaleType="centerCrop"
        android:src="@drawable/popcorn" />

    <TextView
        android:id="@+id/welcome_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:padding="25dp"
        android:text="Welcome to Popcorn Factory, home of the best series and movies. Just lay down, make some popcorn and enjoy!"
        android:textAlignment="viewStart"
        android:textAllCaps="false"
        android:textColor="@color/texto"
        android:textSize="16sp" />

    <Button
        android:id="@+id/start"
        android:layout_width="237dp"
        android:layout_height="39dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@color/titulos"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="GET ME IN!"
        android:textColor="@color/fondo"/>

</LinearLayout>